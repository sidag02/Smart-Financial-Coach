# Copy to .env and fill in. Never commit .env.
SFC_LOG_LEVEL=INFO
# SFC_DATA_DIR=./data
# SFC_ARTIFACTS_DIR=./artifacts
# SFC_MLFLOW_TRACKING_URI=          # default: local store in mlruns/
# SFC_LLM_MODEL=claude-opus-5-5
# SFC_LLM_EFFORT=low
# SFC_LLM_API_KEY=                  # or ANTHROPIC_API_KEY; without one, chat says it's unavailable

# Web app (sfc-web serve). `--dev` fills in throwaway values for a local run
# SFC_DEMO_PASSWORD=                # the shared demo password, at least 8 characters
# SFC_SESSION_SECRET=               # e.g. python -c "import secrets; print(secrets.token_hex(32))"
# SFC_QUICK_SIGNIN=false            # one-click demo sign-in: local only
# SFC_SECURE_COOKIES=true           # false only for plain http
# SFC_COACH_NAME=Wren
